rules_version = '2';

// ============================================================
// SONDAJ — Règles de sécurité Firestore · CAP2030
// ------------------------------------------------------------
// Philosophie :
//   • Tout le monde peut LIRE (nécessaire pour la projection
//     et pour que les participants voient la question active).
//   • Tout le monde peut CRÉER une réponse — mais uniquement
//     une réponse bien formée, ni trop longue, ni modifiable.
//   • Seul l'animateur authentifié (toi) peut créer/modifier
//     les conférences et les questions.
//
// ⚠️ Remplace ADMIN_EMAIL par ton adresse (celle du compte
//    créé dans Firebase > Authentication > Email/Password).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function estAdmin() {
      return request.auth != null
        && request.auth.token.email == "nicolas.meron@cap2030.com";
    }

    match /conferences/{confId} {
      allow read: if true;
      allow write: if estAdmin();

      match /questions/{qId} {
        allow read: if true;
        allow write: if estAdmin();

        match /reponses/{rId} {
          allow read: if true;

          // Un participant peut CRÉER une réponse, jamais la
          // modifier ni la supprimer (anti-vandalisme ado 😄)
          allow create: if
            // la question doit être ouverte au vote
            get(/databases/$(database)/documents/conferences/$(confId)/questions/$(qId)).data.statut == "ouverte"
            // champs autorisés uniquement
            && request.resource.data.keys().hasOnly(["valeur", "prenom", "device", "ts"])
            // valeur : texte court, nombre 0-100, ou liste de textes courts
            && (
              (request.resource.data.valeur is string
                && request.resource.data.valeur.size() > 0
                && request.resource.data.valeur.size() <= 300)
              || (request.resource.data.valeur is number
                && request.resource.data.valeur >= 0
                && request.resource.data.valeur <= 100)
              || (request.resource.data.valeur is list
                && request.resource.data.valeur.size() <= 10)
            )
            // prénom optionnel, court
            && (!("prenom" in request.resource.data)
                || (request.resource.data.prenom is string
                    && request.resource.data.prenom.size() <= 40));

          allow update, delete: if estAdmin();
        }
      }
    }
  }
}
